NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
# Optional: the model that turns a typed custom rule into JSON (Custom Rules page). Defaults to OPENROUTER_MODEL, then google/gemini-2.5-flash.
OPENROUTER_RULES_MODEL=
NEXT_PUBLIC_CLARITY_PROJECT_ID=
# PIN gating the still-in-progress Catalog Ads section (see PROJECT_STATUS.md). Defaults to 392164 if unset.
# Google sign-in (Google first, then Connect Facebook). On for everyone once the Google client and who-may-sign-in are set.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_AUTH_DOMAINS= # comma-separated email domains allowed to sign in, e.g. pickrr.com,shiprocket.in
GOOGLE_AUTH_ALLOWLIST= # optional: single extra emails allowed on top of the domains
GOOGLE_AUTH_ADMINS= # emails that may open /identity-links (falls back to GOOGLE_AUTH_ALLOWLIST)
GOOGLE_AUTH_MODE= # on (default) | test (only browsers with the test cookie) | off (back to Facebook-only sign-in)
GOOGLE_TEST_KEY= # only for mode=test: long random string, 16+ characters
DATABASE_URL= # Neon Postgres, holds the Google <> Facebook mapping table (identity_links)
